{{define "collection"}}<!DOCTYPE HTML>
<html lang="{{if .Language}}{{.Language}}{{else}}{{.MainLanguage}}{{end}}" dir="{{.Direction}}">
	<head prefix="og: http://ogp.me/ns# article: http://ogp.me/ns/article#">
		<meta charset="utf-8">

		<title>{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}</title>
		<meta name="title" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">
		
		<link rel="stylesheet" type="text/css" href="/css/write.css" />
		<link rel="stylesheet" type="text/css" href="/css/toc.css" />
		{{if .CustomCSS}}<link rel="stylesheet" type="text/css" href="/local/custom.css" />{{end}}
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="canonical" href="{{.CanonicalURL}}" />
                {{if gt .CurrentPage 1}}<link rel="prev" href="{{.PrevPageURL .Prefix .NavSuffix .CurrentPage .IsTopLevel}}">{{end}}
                {{if lt .CurrentPage .TotalPages}}<link rel="next" href="{{.NextPageURL .Prefix .NavSuffix .CurrentPage .IsTopLevel}}">{{end}}
		{{if not .Collection.IsPrivate}}<link rel="alternate" type="application/rss+xml" title="{{.DisplayTitle}} &raquo; Feed" href="{{.CanonicalURL}}feed/" />{{end}}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<meta name="generator" content="WriteFreely">
		<meta name="description" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">
		<meta itemprop="name" content="{{.Collection.DisplayTitle}}">
		<meta itemprop="description" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">

		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">
		<meta name="twitter:image" content="{{.Collection.AvatarURL}}">
		<meta name="twitter:description" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">

		<meta property="og:title" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}" />
		<meta property="og:site_name" content="{{.DisplayTitle}}" />
		<meta property="og:type" content="article" />
		<meta property="og:url" content="{{.CanonicalURL}}tag:{{.Tag}}" />
		<meta property="og:description" content="{{localstr "Search results" .MainLanguage}} &mdash; {{.Collection.DisplayTitle}}">
		<meta property="og:image" content="{{.Collection.AvatarURL}}">
		{{template "collection-meta" .}}
		{{if .Collection.StyleSheet}}<style type="text/css">{{.Collection.StyleSheetDisplay}}</style>{{end}}

		{{if .Collection.RenderMathJax}}
		  <!-- Add mathjax logic -->
		  {{template "mathjax" .}}
		{{end}}

		<!-- Add highlighting logic -->
		{{template "highlighting" . }}

	</head>
	<body id="subpage">
		
		<div id="overlay"></div>

		<header>
		<h1 dir="{{.Direction}}" id="blog-title"><a href="{{if .IsTopLevel}}/{{else}}/{{.Collection.Alias}}/{{end}}" class="h-card p-author">{{.Collection.DisplayTitle}}</a></h1>
		<nav>
		{{template "pinned" .}}
		</nav>
		</header>
		
		{{if .Silenced}}
			{{template "user-silenced"}}
		{{end}}
		{{if .Posts}}<section id="wrapper" itemscope itemtype="http://schema.org/Blog">{{else}}<div id="wrapper">{{end}}
			<h1 class="tag-title">{{localstr "Search results" .MainLanguage}}</h1>
                        <div class="results">
                            <p><code>{{if .Language}}lang:{{end}}{{.Tag}}</code> &mdash; {{.TotalPosts}} {{localstr (pluralize "result" "results" .TotalPosts) .MainLanguage}}</p>
                        </div>
			{{template "posts" .}}

		{{template "paging" .}}

		{{if .Posts}}</section>{{else}}</div>{{end}}

                {{template "footer-branding" .}}
	</body>

	{{template "canshowscript" .}}
	<script src="/js/localdate.js"></script>
	{{if .IsOwner}}
	<script src="/js/h.js"></script>
	<script src="/js/postactions.js"></script>
	{{end}}
	<script type="text/javascript" src="/js/toc.js"></script>
	<script type="text/javascript">
	let extraItems = [];
	let elNext = document.getElementById("next-page");
	let elPrev = document.getElementById("prev-page");
	if (elNext != null) {
		let item = new TocItem(elNext.text, 0, 0, elNext);
		extraItems.push(item);
	}
	if (elPrev != null) {
		let item = new TocItem(elPrev.text, 0, 0, elPrev);
		extraItems.push(item);
	}
	document.addEventListener("DOMContentLoaded",
                initToc(".tag-title,.post-title", "#wrapper", extraItems));

{{if .IsOwner}}
{{template "delete_action" .}}
{{template "pin_action" .}}
{{end}}

	{{template "webfonts" .}}
	</script>
</html>{{end}}
